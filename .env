# URL dasar API backend Laravel.
# WAJIB berakhiran /api/v1 — rute Laravel berada di prefix /api (bootstrap/app.php)
# ditambah grup v1 (routes/api.php). Akhiran ini juga dipakai resources.js untuk
# membentuk alamat /storage foto galeri & bukti transfer.
#
# Satu domain (produksi)   : /api/v1
# Domain backend terpisah  : https://api-anda.com/api/v1
#
# Nilai ini DIBAKAR saat `npm run build` — ubah lalu build ulang, mengubahnya
# di peladen tidak berpengaruh.
VITE_API_URL=/api/index.php/api/v1
VITE_STORAGE_URL=/api/storage